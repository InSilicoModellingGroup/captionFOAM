FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      e;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 -3 0 0 0 0 0];

internalField  uniform 1.0e13;

boundaryField
{    
    electrode
    {
        type            zeroGradient;
    }

    uniformInlet
    {
        type            zeroGradient;
    }

    nonUniformInlet
    {
        type            zeroGradient;
    }

    outlet
    {
        type            speciesWallFluxCorrected;
        tempField       TEle_K;
        reflectionFraction  0.7;
        value           uniform 0;
    }

    topBoundary
    {
        type            zeroGradient;
    }

    frontWedge
    {
        type            wedge;
    }

    backWedge
    {
        type            wedge;
    }
}

