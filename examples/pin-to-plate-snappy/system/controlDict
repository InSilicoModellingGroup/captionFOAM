FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     plasmaReactingFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         50.0e-9;

deltaT          1e-14;

writeControl    adjustableRunTime;

writeInterval   1.0e-10;

purgeWrite      0;

writeFormat     ascii;

writePrecision  12;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable true;

adjustTimeStep  true;

maxCo           0.01;

maxRegionLoops  10;

maxRegionLoopsExtAmpEqn  3000;

customUpdatePlasmaCoeffs true;

plasmaCoeffsUpdateInterval 1;

printScreenResults 100;

