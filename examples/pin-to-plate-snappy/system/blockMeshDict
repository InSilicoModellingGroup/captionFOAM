FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale 1.0e-3;

// Geometric parameters
D_e 0.125;    // Electrode diameter
D_i 2.0;
D_a 20.0;

L_e 0.5;        // Electrode length
L_d 3.5;       // Dielectric length (electrode + dielectric region)
L_a 5.5;      // Total length

minDz 4.0e-3;    // Minimum cell size in Z direction
minDy 4.0e-3;    // Minimum cell size in Y direction

expRatioZele 0.2; // Expansion ratio in Z direction in electrode region
expRatioZuniform 1.0; // Expansion ratio in Z direction in uniform region
expRatioZnonUniform 1.0; // Expansion ratio in Z direction in non-uniform region

expRatioYuniform 1.0; // Expansion ratio in Y direction in uniform region
expRatioYnonUniform 50.0; // Expansion ratio in Y direction in non-uniform region

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// The rest of the code automatically creates the geometry, using the above parameters.
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Dimensions
X_beg 0;
X_end 0.1;
R_e #calc "$D_e /2.0";
R_i #calc "$D_i /2.0";
R_a #calc "$D_a /2.0";
Z_b #calc "-$L_e";
Z_e #calc "0";
Z_d #calc "$L_d-$L_e";
Z_a #calc "$L_a-$L_e";

// y-axis: Uniform
cells (#codeStream {
    code #{
        scalar r = $expRatioYuniform;
        r = 1.0/r;
        if (mag(r-1.0)<SMALL)
        {
            os << round($R_i/$minDy) << endl;
        }
        else
        {
            scalar alpha = $R_i/$minDy;
            scalar k = 1+(1.0-r)/(r*log(1.0/r)*(alpha-1.0)); // initial guess
            int count = 1;
            scalar F = 1.0;
            while (abs(F)>SMALL && count<2000)
            {
                F = (1.0-pow(r,k))/(r-pow(r,k)) - alpha;
                scalar G = (1-r)*pow(r,k)*log(r)/(r-pow(r,k))/(r-pow(r,k));
                k = k - F/G;
                count++;
            }
            os << round(k/(k-1.0)) << endl;
        }
    #};
} );
cellsRadialUniform #calc "int($cells)";

maxDyUniform (#codeStream {
    code #{
        scalar suma = 0;
        scalar r = 1.0/$expRatioYuniform;
        int i = 0;
        for (i=0 ; i<$cellsRadialUniform ; i++)
            suma += pow(r , (i/($cellsRadialUniform - 1.0)) );
        Info << "--- y-axis uniform min cell size: " << $minDy << endl;
        Info << "--- y-axis uniform max cell size: " << ($R_i)/suma << endl;
        os << ($R_i)/suma << endl;
    #};
} );

// y-axis: Non-uniform
cells (#codeStream {
    code #{
        scalar r = $expRatioYnonUniform;
        r = 1.0/r;
        if (mag(r-1.0)<SMALL)
        {
            os << round(($R_a-$R_i)/$maxDyUniform) << endl;
        }
        else
        {
            scalar alpha = ($R_a-$R_i)/$maxDyUniform;
            scalar k = 1+(1.0-r)/(r*log(1.0/r)*(alpha-1.0)); // initial guess
            int count = 1;
            scalar F = 1.0;
            while (abs(F)>SMALL && count<2000)
            {
                F = (1.0-pow(r,k))/(r-pow(r,k)) - alpha;
                scalar G = (1-r)*pow(r,k)*log(r)/(r-pow(r,k))/(r-pow(r,k));
                k = k - F/G;
                count++;
            }
            os << round(k/(k-1.0)) << endl;
        }
    #};
} );
cellsRadialNonuniform #calc "int($cells)";


// z-axis: Electrode
cells (#codeStream {
    code #{
        scalar r = $expRatioZele;
        if (mag(r-1.0)<SMALL)
        {
            os << round($L_e /$minDz) << endl;
        }
        else
        {
            scalar alpha = $L_e/$minDz;
            scalar k = 1+(1.0-r)/(r*log(1.0/r)*(alpha-1.0)); // initial guess
            int count = 1;
            scalar F = 1.0;
            while (abs(F)>SMALL && count<2000)
            {
                F = (1.0-pow(r,k))/(r-pow(r,k)) - alpha;
                scalar G = (1-r)*pow(r,k)*log(r)/(r-pow(r,k))/(r-pow(r,k));
                k = k - F/G;
                count++;
            }
            os << round(k/(k-1.0)) << endl;
        }
    #};
} );
cellsAxialEle #calc "int($cells)";

// z-axis: Uniform
cells (#codeStream {
    code #{
        scalar r = $expRatioZuniform;
        r = 1.0/r;
        if (mag(r-1.0)<SMALL)
        {
            os << round(($L_d-$L_e+$R_e) /$minDz) << endl;
        }
        else
        {
            scalar alpha = ($L_d-$L_e+$R_e)/$minDz;
            scalar k = 1+(1.0-r)/(r*log(1.0/r)*(alpha-1.0)); // initial guess
            int count = 1;
            scalar F = 1.0;
            while (abs(F)>SMALL && count<2000)
            {
                F = (1.0-pow(r,k))/(r-pow(r,k)) - alpha;
                scalar G = (1-r)*pow(r,k)*log(r)/(r-pow(r,k))/(r-pow(r,k));
                k = k - F/G;
                count++;
            }
            os << round(k/(k-1.0)) << endl;
        }
    #};
} );
cellsAxialUniform #calc "int($cells)";

maxDzUniform (#codeStream {
    code #{
        scalar suma = 0;
        scalar r = 1.0/$expRatioZuniform;
        int i = 0;
        for (i=0 ; i<$cellsAxialUniform ; i++)
            suma += pow(r , (i/($cellsAxialUniform - 1.0)) );
        Info << "--- z-axis uniform min cell size: " << $minDz << endl;
        Info << "--- z-axis uniform max cell size: " << ($L_d-$L_e+$R_e)/suma << endl;
        os << ($L_d-$L_e+$R_e)/suma << endl;
    #};
} );

// z-axis: Non-uniform
cells (#codeStream {
    code #{
        scalar r = $expRatioZnonUniform;
        r = 1.0/r;
        if (mag(r-1.0)<SMALL)
        {
            os << round(($L_a-$L_d) /$maxDzUniform) << endl;
        }
        else
        {
            scalar alpha = ($L_a-$L_d)/$maxDzUniform;
            scalar k = 1+(1.0-r)/(r*log(1.0/r)*(alpha-1.0)); // initial guess
            int count = 1;
            scalar F = 1.0;
            while (abs(F)>SMALL && count<2000)
            {
                F = (1.0-pow(r,k))/(r-pow(r,k)) - alpha;
                scalar G = (1-r)*pow(r,k)*log(r)/(r-pow(r,k))/(r-pow(r,k));
                k = k - F/G;
                count++;
            }
            os << round(k/(k-1.0)) << endl;
        }
    #};
} );
cellsAxialNonUniform #calc "int($cells)";


// Calculate vertices' coordinates
Y0 #calc "0";
Y1 #calc "$R_i";
Y2 #calc "$R_a";
Z0 #calc "$Z_b";
Z1 #calc "$Z_e";
Z2 #calc "$Z_d";
Z3 #calc "$Z_a";

vertices
(
    ($X_beg $Y0 $Z0)            // 0
    ($X_beg $Y0 $Z1)            // 1
    ($X_beg $Y0 $Z2)            // 2
    ($X_beg $Y0 $Z3)            // 3
    ($X_beg $Y1 $Z0)            // 4
    ($X_beg $Y1 $Z1)            // 5
    ($X_beg $Y1 $Z2)            // 6
    ($X_beg $Y1 $Z3)            // 7
    ($X_beg $Y2 $Z0)            // 8
    ($X_beg $Y2 $Z1)            // 9
    ($X_beg $Y2 $Z2)            // 10
    ($X_beg $Y2 $Z3)            // 11

    ($X_end $Y0 $Z0)           // 12
    ($X_end $Y0 $Z1)           // 13
    ($X_end $Y0 $Z2)           // 14
    ($X_end $Y0 $Z3)           // 15
    ($X_end $Y1 $Z0)           // 16
    ($X_end $Y1 $Z1)           // 17
    ($X_end $Y1 $Z2)           // 18
    ($X_end $Y1 $Z3)           // 19
    ($X_end $Y2 $Z0)           // 20
    ($X_end $Y2 $Z1)           // 21
    ($X_end $Y2 $Z2)           // 22
    ($X_end $Y2 $Z3)           // 23
);

blocks
(
    hex (0 12 16 4 1 13 17 5) (1 $cellsRadialUniform $cellsAxialEle) simpleGrading (1 $expRatioYuniform $expRatioZele)      // Block 0
    hex (1 13 17 5 2 14 18 6) (1 $cellsRadialUniform $cellsAxialUniform) simpleGrading (1 $expRatioYuniform $expRatioZuniform)      // Block 1
    hex (2 14 18 6 3 15 19 7) (1 $cellsRadialUniform $cellsAxialNonUniform) simpleGrading (1 $expRatioYuniform $expRatioZnonUniform)      // Block 2
    hex (4 16 20 8 5 17 21 9) (1 $cellsRadialNonuniform $cellsAxialEle) simpleGrading (1 $expRatioYnonUniform $expRatioZele)      // Block 3
    hex (5 17 21 9 6 18 22 10) (1 $cellsRadialNonuniform $cellsAxialUniform) simpleGrading (1 $expRatioYnonUniform $expRatioZuniform)      // Block 4
    hex (6 18 22 10 7 19 23 11) (1 $cellsRadialNonuniform $cellsAxialNonUniform) simpleGrading (1 $expRatioYnonUniform $expRatioZnonUniform)      // Block 5
);

boundary
(
    uniformInlet
    {
        type patch;
        faces
        (
            (0 4 16 12)   // From Block 0
        );
    }

    nonUniformInlet
    {
        type patch;
        faces
        (
            (4 8 20 16)   // From Block 3
        );
    }

    outlet
    {
        type patch;
        faces
        (
            (3 15 19 7)  // From Block 2
            (7 19 23 11)  // From Block 5
        );
    }

    axis
    {
        type patch;
        faces
        (
            (0 12 13 1)     // From Block 0
            (1 13 14 2)     // From Block 1
            (2 14 15 3)     // From Block 2
        );
    }

    topBoundary
    {
        type patch;
        faces
        (
            (8 9 21 20)   // From Block 3
            (9 10 22 21)   // From Block 4
            (10 11 23 22) // From Block 5
        );
    }

    frontWedge
    {
        type empty;
        faces
        (
            (0 1 5 4)     // From Block 0
            (1 2 6 5)     // From Block 1
            (2 3 7 6)     // From Block 2
            (4 5 9 8)     // From Block 3
            (5 6 10 9)    // From Block 4
            (6 7 11 10)   // From Block 5
        );
    }

    backWedge
    {
        type empty;
        faces
        (
            (12 16 17 13)     // From Block 0
            (13 17 18 14)     // From Block 1
            (14 18 19 15)     // From Block 2
            (16 20 21 17)     // From Block 3
            (17 21 22 18)     // From Block 4
            (18 22 23 19)     // From Block 5
        );
    }

);
