FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale 1.0e-3;

// Geometric parameters
R_e 0.0625;   // Electrode radius
R_uni 1.0;    // Radius of the uniform region
R_a 10.0;     // Domain radius

L_e 0.5;      // Electrode length, spanning z = -L_e up to the tip at z = 0
L_a 5.0;      // Domain length above the tip, spanning z = 0 to z = L_a

minDz 4.0e-3;    // Minimum cell size in Z direction
minDy 4.0e-3;    // Minimum cell size in Y direction

expRatioZele 0.2; // Expansion ratio in Z direction in electrode region
expRatioYnonUniform 50.0; // Expansion ratio in Y direction in non-uniform region


// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// The rest of the code automatically creates the geometry, using the above parameters.
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Dimensions
X_beg 0;
X_end 0.1;
R_n #calc "$R_a-$R_uni";  // Non-uniform region radial length
Z_b #calc "-$L_e";
Z_e #calc "0";
Z_a #calc "$L_a";

// y-axis: Uniform.
cellsRadialUniform #calc "int(round(scalar($R_uni)/$minDy))";
maxDyUniform #calc "scalar($R_uni)/$cellsRadialUniform";

// y-axis: Non-uniform
cells (#codeStream {
    code #{
        scalar r = $expRatioYnonUniform;
        r = 1.0/r;
        if (mag(r-1.0)<SMALL)
        {
            os << round($R_n/$maxDyUniform) << endl;
        }
        else
        {
            scalar alpha = $R_n/$maxDyUniform;
            scalar k = 1+(1.0-r)/(r*log(1.0/r)*(alpha-1.0)); 
            int count = 1;
            scalar F = 1.0;
            while (abs(F)>SMALL && count<2000)
            {
                F = (1.0-pow(r,k))/(r-pow(r,k)) - alpha;
                scalar G = (1-r)*pow(r,k)*log(r)/(r-pow(r,k))/(r-pow(r,k));
                k = k - F/G;
                count++;
            }
            os << round(k/(k-1.0)) << endl;
        }
    #};
} );

cellsRadialNonuniform #calc "int($cells)";
cellsRadial #calc "int($cellsRadialUniform + $cellsRadialNonuniform)";


// z-axis: Uniform.
cellsAxialUniform #calc "int(round((scalar($L_a)+$R_e)/$minDz))";
maxDzUniform #calc "scalar($L_a)/$cellsAxialUniform";

// z-axis: Electrode
cells (#codeStream {
    code #{
        scalar r = $expRatioZele;
        if (mag(r-1.0)<SMALL)
        {
            os << round($L_e /$maxDzUniform) << endl;
        }
        else
        {
            scalar alpha = $L_e/$maxDzUniform;
            scalar k = 1+(1.0-r)/(r*log(1.0/r)*(alpha-1.0)); // initial guess
            int count = 1;
            scalar F = 1.0;
            while (abs(F)>SMALL && count<2000)
            {
                F = (1.0-pow(r,k))/(r-pow(r,k)) - alpha;
                scalar G = (1-r)*pow(r,k)*log(r)/(r-pow(r,k))/(r-pow(r,k));
                k = k - F/G;
                count++;
            }
            os << round(k/(k-1.0)) << endl;
        }
    #};
} );

cellsAxialEle #calc "int($cells)";
cellsAxial #calc "int($cellsAxialEle + $cellsAxialUniform)";

// Calculate vertices' coordinates
Y0 #calc "0";
Y1 #calc "$R_a";
Z0 #calc "$Z_b";
Z1 #calc "$Z_a";

vertices
(
    ($X_beg $Y0 $Z0)           // 0
    ($X_beg $Y0 $Z1)           // 1
    ($X_beg $Y1 $Z0)           // 2
    ($X_beg $Y1 $Z1)           // 3

    ($X_end $Y0 $Z0)           // 4
    ($X_end $Y0 $Z1)           // 5
    ($X_end $Y1 $Z0)           // 6
    ($X_end $Y1 $Z1)           // 7
);

blocks
(
    hex (0 4 6 2 1 5 7 3) (1 $cellsRadial $cellsAxial)
    simpleGrading
    (
        1
        (
            ($R_uni $cellsRadialUniform 1)
            ($R_n $cellsRadialNonuniform $expRatioYnonUniform)
        )
        (
            ($L_e $cellsAxialEle $expRatioZele)
            ($L_a $cellsAxialUniform 1)
        )
    )
);

boundary
(
    inlet
    {
        type patch;
        faces
        (
            (0 2 6 4)
        );
    }

    target
    {
        type patch;
        faces
        (
            (1 5 7 3)
        );
    }

    axis
    {
        type patch;
        faces
        (
            (0 4 5 1)
        );
    }

    farfield
    {
        type patch;
        faces
        (
            (2 3 7 6)
        );
    }

    frontWedge
    {
        type empty;
        faces
        (
            (0 1 3 2)
        );
    }

    backWedge
    {
        type empty;
        faces
        (
            (4 6 7 5)
        );
    }

);
