FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      physicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

gammaSE     0.01;

// Atmosphere conditions
atmosphericConditions
{
    pGasValue           101325;
    TGasValue           300;
    rhoGasValue         1.225;
    TEleInitValue       2;
}

// Transport and reaction coefficients approximation
plasmaCoeffApprox
{
    localCoeffApprox
    {
        type                LMEA;            // LFA or LMEA (should be consistent with bolsig+ input file)
        solveEleEnergyEqn   yes;             // yes (default) or no (if LMEA then overrides to yes)
    }
    backgndAtmosphere
    {
        type                singleGas;  // background atmosphere type: singleGas (default) or twoGasMixture
    }
}


// Voltage characteristics
type     DC;

peakVoltage     10.0e3;

