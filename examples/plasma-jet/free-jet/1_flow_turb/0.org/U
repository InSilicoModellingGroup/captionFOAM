FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    HeInlet
    {
        type            turbulentInlet;
        referenceField  uniform (0 0 48.2582);
        fluctuationScale (0.01 0.01 0.02);
        value           uniform (0 0 48.2582);
    }   

    airInlet
    {
        type            zeroGradient;
    }

    dielWalls
    {
        type            noSlip;
    }

    outlet
    {
        type            pressureInletOutletVelocity;
        inletValue      uniform (0 0 0);
        value           uniform (0 0 0);
    }

    farfield
    {
        type            pressureInletOutletVelocity;
        inletValue      uniform (0 0 0);
        value           uniform (0 0 0);
    }
}


