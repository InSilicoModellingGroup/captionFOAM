FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         backward;
}

gradSchemes
{
    default         leastSquares;
    // grad(voltExt)       leastSquares;
    // default         cellLimited Gauss linear 1;
}

divSchemes
{
    default         Gauss upwind;
    // div(NiFlux,Ni)  Gauss linearUpwind limited;
    // default         Gauss limitedLinear 1;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         corrected;
}


