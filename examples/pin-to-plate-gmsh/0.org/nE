FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nE;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 6.408707e-08;

boundaryField
{    
    electrode
    {
        type            zeroGradient;
    }

    uniformInlet
    {
        type            zeroGradient;
    }

    nonUniformInlet
    {
        type            zeroGradient;
    }

    outlet
    {
        type            zeroGradient;
    }

    topBoundary
    {
        type            zeroGradient;
    }

    frontWedge
    {
        type            wedge;
    }

    backWedge
    {
        type            wedge;
    }
}

