FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

actions
(
    // Dielectric
    {
        name    dielectricCells;
        type    cellSet;
        action  new;
        source  boxToCell;
        sourceInfo
        {
            box (-1 0 3.0e-3)(1 1 4.0e-3);
        }
    }
    {
        name    dielectric;
        type    cellZoneSet;
        action  new;
        source  setToCellZone;
        sourceInfo
        {
            set dielectricCells;
        }
    }

    // Region0
    {
        name    region0Cells;
        type    cellSet;
        action  new;
        source  boxToCell;
        sourceInfo
        {
            box (-1 0 -3.0)(1 1 4.0);
        }
    }
    {
        name    region0Cells;
        type    cellSet;
        action  delete;
        source  cellToCell;
        sourceInfo
        {
            set dielectricCells;
        }
    }
    {
        name    region0;
        type    cellZoneSet;
        action  new;
        source  setToCellZone;
        sourceInfo
        {
            set region0Cells;
        }
    }
);

