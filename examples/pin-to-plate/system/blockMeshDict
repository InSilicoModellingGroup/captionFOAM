// y-axis: Gas
cells (#codeStream {
    code #{
        scalar r = $expRatioYgas;
        r = 1.0/r;
        if (mag(r-1.0)<SMALL)
        {
            os << round($R_i/$minDy) << endl;
        }
        else
        {
            scalar alpha = $R_i/$minDy;
            scalar k = 1+(1.0-r)/(r*log(1.0/r)*(alpha-1.0)); // initial guess
            int count = 1;
            scalar F = 1.0;
            while (abs(F)>SMALL && count<2000)
            {
                F = (1.0-pow(r,k))/(r-pow(r,k)) - alpha;
                scalar G = (1-r)*pow(r,k)*log(r)/(r-pow(r,k))/(r-pow(r,k));
                k = k - F/G;
                count++;
            }
            os << round(k/(k-1.0)) << endl;
        }
    #};
} ); 
cellsRadialGas #calc "int($cells)";

maxDyGas (#codeStream {
    code #{
        scalar suma = 0;
        scalar r = 1.0/$expRatioYgas;
        int i = 0;
        for (i=0 ; i<$cellsRadialGas ; i++)
            suma += pow(r , (i/($cellsRadialGas - 1.0)) );
        Info << "--- y-axis gas min cell size: " << $minDy << endl;
        Info << "--- y-axis gas max cell size: " << ($R_i)/suma << endl;
        os << ($R_i)/suma << endl;
    #};
} ); 

// y-axis: Dielectric
cells (#codeStream {
    code #{
        scalar r = $expRatioYdiel;
        r = 1.0/r;
        if (mag(r-1.0)<SMALL)
        {
            os << round(($R_o-$R_i)/$maxDyGas) << endl;
        }
        else
        {
            scalar alpha = ($R_o-$R_i)/$maxDyGas;
            scalar k = 1+(1.0-r)/(r*log(1.0/r)*(alpha-1.0)); // initial guess
            int count = 1;
            scalar F = 1.0;
            while (abs(F)>SMALL && count<2000)
            {
                F = (1.0-pow(r,k))/(r-pow(r,k)) - alpha;
                scalar G = (1-r)*pow(r,k)*log(r)/(r-pow(r,k))/(r-pow(r,k));
                k = k - F/G;
                count++;
            }
            os << round(k/(k-1.0)) << endl;
        }
    #};
} ); 
