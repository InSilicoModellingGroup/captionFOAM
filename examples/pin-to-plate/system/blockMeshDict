// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale 1.0e-3;

// Geometric parameters
D_e 0.125;    // Electrode diameter
D_i 1.2;
D_o 2.5;
D_a 8.0;

L_e 0.5;        // Electrode length
L_d 3.5;       // Dielectric length (electrode + dielectric region)
L_a 5.5;      // Total length

minDz 4.0e-3;    // Minimum cell size in Z direction
minDy 4.0e-3;    // Minimum cell size in Y direction

expRatioZgas 0.2; // Expansion ratio in Z direction in gas region
expRatioZdiel 1.0; // Expansion ratio in Z direction in dielectric region
expRatioZAir 1.0; // Expansion ratio in Z direction in air region

expRatioYgas 1.0; // Expansion ratio in Y direction in gas region
expRatioYdiel 2.0; // Expansion ratio in Y direction in dielectric region
expRatioYAir 6.0; // Expansion ratio in Y direction in air region

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// The rest of the code automatically creates the geometry, using the above parameters.
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Dimensions
X_beg 0;
X_end 0.1;
R_e #calc "$D_e /2.0";
R_i #calc "$D_i /2.0";
R_o #calc "$D_o /2.0";  
R_a #calc "$D_a /2.0";
Z_b #calc "-$L_e";
Z_e #calc "0";
Z_d #calc "$L_d-$L_e";
Z_a #calc "$L_a-$L_e";

