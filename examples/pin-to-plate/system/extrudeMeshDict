FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      extrudeMeshDict;
}

constructFrom    patch;
sourceCase       ".";

// Choose ONE plane patch to extrude from
sourcePatches    (frontWedge);

// Name of the “other” plane after extrusion (not super important)
exposedPatchName backWedge;

extrudeModel     wedge;

// For wedge/sector extrusion
sectorCoeffs
{
    // Axisymmetric point: should lie on your axis of symmetry
    // In your blockMesh, the axis is along x at y=0, z=0, so (0 0 0) is fine.
    point   (0 0 0);

    // Direction of the rotation axis.
    // For your case (x is axial), the axis is typically (1 0 0).
    axis    (0 0 1);

    // Total wedge angle in degrees (small angle typical: 1–5)
    angle   1;
}

flipNormals false;
mergeFaces  false;
mergeTol 1.0e-12;


